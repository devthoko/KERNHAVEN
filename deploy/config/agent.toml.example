# Kernhaven host agent configuration — /etc/kernhaven/agent.toml
# Unknown keys are rejected at startup.

# Unix socket the Core connects to (directory created by systemd).
socket = "/run/kernhaven/agent.sock"

# Only these UIDs may connect (SO_PEERCRED). Set to the Core user's UID:
#   id -u kernhaven
allowed_uids = [998]

# Public key that verifies the Core's grants. The installer copies it from
# /var/lib/kernhaven/agent-grant.pub to this root-owned path so that the Core
# cannot replace it at runtime.
grant_public_key = "/etc/kernhaven/agent-grant.pub"

# Docker Engine socket.
docker_socket = "/run/docker.sock"

# Image for volume copies before app updates (ADR-0021). The default is
# busybox 1.37.0 pinned by digest; air-gapped hosts point this to a local image.
# helper_image = "busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e"

# Data disks are mounted below this directory (M9). Add it to the Core's
# containers.allowed_bind_roots so apps can use the disks without exceptions.
# mount_root = "/srv/kernhaven"

[log]
level = "info"   # debug | info | warn | error

# Kernhaven Core configuration — /etc/kernhaven/core.toml
# Unknown keys are rejected at startup.

[server]
# Must be a loopback address; external access goes through Caddy (ADR-0010).
listen = "127.0.0.1:8470"
# Time to drain in-flight requests on shutdown (1s..120s).
shutdown_timeout = "15s"
# Maximum request body size in bytes (1 KiB..64 MiB).
max_body_bytes = 1048576
# Browser-facing origin used for CSRF checks and the Secure cookie flag.
# Must be https, except http://localhost for local development.
public_origin = "https://kernhaven.home.arpa"

[storage]
# Absolute path, owned by the service user, mode 0700.
data_dir = "/var/lib/kernhaven"

[log]
# debug | info | warn | error
level = "info"

[agent]
# Unix socket of kernhaven-agent; empty disables container features.
socket = "/run/kernhaven/agent.sock"

# Unix socket of kernhaven-storage (disks and mounts, M9); empty disables
# disk management.
storage_socket = "/run/kernhaven-storage/storage.sock"

# Unix socket of kernhaven-files (file manager, M10); empty disables it.
files_socket = "/run/kernhaven-files/files.sock"

# Unix socket of kernhaven-proxy (Caddy routes and network overview, M12);
# empty disables both.
proxy_socket = "/run/kernhaven-proxy/proxy.sock"

# Unix socket of kernhaven-monitor (host metrics, M14); empty disables them.
monitor_socket = "/run/kernhaven-monitor/monitor.sock"

[metrics]
interval = "15s"   # 5s..60s between samples

[auth]
session_idle_timeout = "30m"      # 5m..24h
session_absolute_timeout = "12h"  # 1h..720h, not shorter than the idle timeout
setup_token_ttl = "24h"           # 10m..72h

[files]
# Largest single upload in the file manager (M10), in bytes.
max_upload_bytes = 21474836480
# Optional: restrict roles per file root (names from the storage service's
# file_roots). Lists only narrow what files.read / files.write allow.
# [files.roots.backups]
# read = ["owner", "admin"]
# write = ["owner"]

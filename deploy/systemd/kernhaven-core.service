[Unit]
Description=Kernhaven Core
Documentation=https://github.com/devthoko/KERNHAVEN
After=network.target
Wants=network.target

[Service]
Type=exec
User=kernhaven
Group=kernhaven
ExecStart=/usr/bin/kernhaven-core -config /etc/kernhaven/core.toml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

StateDirectory=kernhaven
StateDirectoryMode=0700
ConfigurationDirectory=kernhaven
ConfigurationDirectoryMode=0750
UMask=0077

# Sandboxing (ADR-0008). The Core needs no privileges at all.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target

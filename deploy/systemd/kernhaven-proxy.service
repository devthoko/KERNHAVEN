[Unit]
Description=Kernhaven proxy service (configures Caddy, network overview)
Documentation=https://github.com/devthoko/KERNHAVEN
After=kernhaven-caddy.service
Wants=kernhaven-caddy.service

[Service]
Type=exec
# The only process that talks to Caddy's admin API (ADR-0025). It builds the
# whole Caddy configuration from typed routes, so the Core never hands Caddy
# raw configuration. No capabilities, no IP traffic, no Docker, no files.
User=kernhaven-proxy
Group=kernhaven-agent
# /run/kernhaven-caddy (0750, caddy:kernhaven-proxy) holds Caddy's admin socket.
SupplementaryGroups=kernhaven-proxy
ExecStart=/usr/bin/kernhaven-agent -config /etc/kernhaven/proxy.toml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

# /run/kernhaven-proxy (0750, group kernhaven-agent): the Core user is a
# member of kernhaven-agent and connects to proxy.sock (0660).
RuntimeDirectory=kernhaven-proxy
RuntimeDirectoryMode=0750
UMask=0117

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# The host's network namespace is needed to list interfaces (netlink) and
# listening sockets (/proc/self/net); IP traffic itself is denied.
PrivateNetwork=no
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
IPAddressDeny=any

[Install]
WantedBy=multi-user.target

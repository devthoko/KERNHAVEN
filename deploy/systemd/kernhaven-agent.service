[Unit]
Description=Kernhaven host agent (Docker access)
Documentation=https://github.com/devthoko/KERNHAVEN
After=docker.service
Wants=docker.service

[Service]
Type=exec
# The agent is the only Kernhaven component with Docker access (ADR-0003,
# ADR-0005). Docker group membership is root-equivalent, so everything else
# is locked down: no network, no capabilities, read-only system.
User=kernhaven-agent
Group=kernhaven-agent
SupplementaryGroups=docker
ExecStart=/usr/bin/kernhaven-agent -config /etc/kernhaven/agent.toml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

# /run/kernhaven (0750, group kernhaven-agent): the Core user is a member of
# kernhaven-agent and connects to agent.sock (0660).
RuntimeDirectory=kernhaven
RuntimeDirectoryMode=0750
UMask=0117

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
IPAddressDeny=any

[Install]
WantedBy=multi-user.target

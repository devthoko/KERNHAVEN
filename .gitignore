# Credentials and secrets - never commit (see CLAUDE.md)
*.rtf
.env
.env.*
!.env.example
*.pem
*.key
id_*
*_deploy
*creds*
*secret*
# Source code and docs about secret handling (contain no secrets)
!/internal/platform/secretbox/
!/internal/platform/secretbox/*.go
!/docs/adr/0019-secret-encryption.md

# Build output
/bin/
/dist/
node_modules/
*.db
*.sqlite

# Editor / OS
.DS_Store
.idea/
.vscode/

# Web UI build output (embedded into the Core at build time)
/internal/core/webui/dist/*
!/internal/core/webui/dist/.gitkeep
/web/node_modules/
/web/test-results/
/web/playwright-report/
